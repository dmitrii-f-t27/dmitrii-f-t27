// SPDX-License-Identifier: Apache-2.0
// trinityos/specs/os/dev_disp.t27 — устройство DISP: дисплей-лист
//
// Не пиксельный фреймбуфер: гость пишет КОМАНДЫ рисования в кольцо MMIO,
// растеризует носитель (Canvas в обсервере Workbench, HDMI-скан на FPGA).
// Виртуальный холст 1458×729 (2·3^6 × 3^6, аспект 2:1 — равнопромежуточная
// карта мира ложится на него точно: x=(lon+180)/360·1458, y=(90-lat)/180·729).
// φ² + 1/φ² = 3 | TRINITY

module os-dev-disp;

use tritype-base::usize;
use os-mmio-map::MMIO_BASE_WORD;
use os-mmio-map::DISP_REG_OFF;
use os-mmio-map::DISP_RING_OFF;
use os-mmio-map::DISP_RING_WORDS;

// ============================================================================
// Виртуальный холст и палитра
// ============================================================================

pub const VIRT_W : usize = 1458;
pub const VIRT_H : usize = 729;

/// Палитра — 27 цветов, индекс = 3 трита (r,g,b), канал {-1,0,+1}→{0,128,255}:
///   index = (r+1)*9 + (g+1)*3 + (b+1);  0=чёрный, 13=серый, 26=белый,
///   6=зелёный, 8=циан, 18=красный, 24=жёлтый, 2=синий.
pub const PALETTE_SIZE : usize = 27;

// ============================================================================
// Регистры (смещения в словах от начала блока DISP_REG)
// ============================================================================

/// Управление (WO): бит 0 — COMMIT (защёлкнуть кадр)
pub const R_CTRL : usize = 0;
/// Статус (RO): бит 0 — носитель жив
pub const R_STATUS : usize = 1;
/// Индекс чтения устройства в кольце (RO, в словах)
pub const R_HEAD : usize = 2;
/// Индекс записи гостя в кольце (RW, в словах; двигать на 2 после команды)
pub const R_TAIL : usize = 3;
/// Номер защёлкнутого кадра (RO, растёт на 1 после каждого COMMIT)
pub const R_FRAME_ID : usize = 4;
/// Маска видимости слоёв (RW): бит i — слой i виден; 27 слоёв, бит 0..26
pub const R_LAYER_MASK : usize = 5;

/// COMMIT-бит регистра CTRL
pub const CTRL_COMMIT : usize = 1;

// ============================================================================
// Команда — 2 слова в кольце
//   w0 = op(u8) | layer(u8)<<8 | color(u8)<<16 | size(u8)<<24
//   w1 = x(i16) | y(i16)<<16
// ============================================================================

pub const OP_NOP : usize = 0;
/// Очистить слой layer (w1 игнорируется)
pub const OP_CLEAR : usize = 1;
/// Точка (x,y), цвет color, диаметр size (в пикселях холста)
pub const OP_POINT : usize = 2;
/// Поставить курсор слоя в (x,y) без рисования
pub const OP_MOVE_TO : usize = 3;
/// Линия от курсора слоя к (x,y), цвет color, толщина size; курсор := (x,y)
pub const OP_LINE_TO : usize = 4;
/// Глиф ASCII: код символа в size, позиция (x,y), цвет color
pub const OP_GLYPH : usize = 5;

pub const DispCmd = struct {
    op : u8,
    layer : u8,
    color : u8,
    size : u8,
    x : i16,
    y : i16,
};

// ============================================================================
// Семантика
// ============================================================================

/// Кадр: гость пишет команды в кольцо (двигая TAIL), затем CTRL |= COMMIT.
/// Устройство потребляет [HEAD, TAIL), защёлкивает список как кадр FRAME_ID+1.
/// Состояние слоёв персистентно между кадрами: слой меняется только командами
/// CLEAR/рисования — можно обновлять один слой, не перерисовывая остальные.
fn disp_commit() -> void {
    // Implementation: HEAD := TAIL; FRAME_ID += 1; кадр уходит растеризатору.
}

// ============================================================================
// Инварианты и голдены
// ============================================================================
//
// INVARIANT D1: гость двигает TAIL только вперёд и только на чётное число слов.
// INVARIANT D2: при переполнении кольца (TAIL догнал HEAD-2) запись поверх
//              непотреблённых команд запрещена; гость обязан COMMIT'ить чаще.
// INVARIANT D3: неизвестный op — команда игнорируется целиком (2 слова).
// INVARIANT D4: layer > 26 или color > 26 — команда игнорируется.
// INVARIANT D5: координаты вне холста допустимы (клиппинг у растеризатора).
//
// GOLDEN G-DISP-1: CLEAR(0); POINT(0, зелёный=6, size=5, x=729, y=364);
//   COMMIT → FRAME_ID=1, кадр из 2 команд, HEAD=TAIL=4.
// GOLDEN G-DISP-2: две команды без COMMIT → FRAME_ID=0, кадров нет.
// GOLDEN G-DISP-3: MOVE_TO(10,10); LINE_TO(100,10) — курсор слоя после
//   кадра в (100,10); LINE_TO следующего кадра стартует из него.
