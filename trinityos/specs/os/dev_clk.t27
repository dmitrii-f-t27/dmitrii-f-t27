// trinityos/specs/os/dev_clk.t27 — устройство CLK: время
// φ² + 1/φ² = 3 | TRINITY

module os-dev-clk;

use tritype-base::usize;
use os-mmio-map::MMIO_BASE_WORD;
use os-mmio-map::CLK_BLOCK_OFF;

// ============================================================================
// Регистры (смещения в словах от начала блока CLK; все — read-only для гостя)
// ============================================================================

/// UNIX-время, секунды, младшее слово
pub const R_UNIX_LO : usize = 0;
/// UNIX-время, секунды, старшее слово
pub const R_UNIX_HI : usize = 1;
/// Аптайм устройства, миллисекунды, младшее слово
pub const R_UPTIME_MS_LO : usize = 2;
/// Аптайм устройства, миллисекунды, старшее слово
pub const R_UPTIME_MS_HI : usize = 3;
/// Частота тиков носителя, Гц (эмулятор: 1000; FPGA: тактовая делённая)
pub const R_TICK_HZ : usize = 4;

// ============================================================================
// Семантика
// ============================================================================

/// Чтение регистра CLK
fn clk_load(reg_off: usize) -> u32 {
    // Implementation: вернуть текущее значение; пара LO/HI атомарна:
    // чтение LO защёлкивает HI до следующего чтения LO (snapshot-протокол).
}

/// Запись в блок CLK
fn clk_store(reg_off: usize, value: u32) -> void {
    // Implementation: игнорируется (RO-устройство). Не fault: гость может
    // безопасно проходить окно линейной инициализацией нулями.
}

// ============================================================================
// Инварианты и голдены
// ============================================================================
//
// INVARIANT C1: UPTIME монотонно не убывает между чтениями.
// INVARIANT C2: пара LO/HI после snapshot-протокола не рвётся на переносе.
// INVARIANT C3: TICK_HZ постоянен в течение сессии.
//
// GOLDEN G-CLK-1: при unix=1_787_562_715, uptime_ms=12_345:
//   load(R_UNIX_LO)=1_787_562_715, load(R_UNIX_HI)=0,
//   load(R_UPTIME_MS_LO)=12_345, load(R_UPTIME_MS_HI)=0, load(R_TICK_HZ)=1000.
// GOLDEN G-CLK-2: store в любой регистр CLK не меняет последующие load.
