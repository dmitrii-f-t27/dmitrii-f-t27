// trinityos/specs/os/dev_inp.t27 — устройство INP: события ввода
// φ² + 1/φ² = 3 | TRINITY

module os-dev-inp;

use tritype-base::usize;
use os-mmio-map::MMIO_BASE_WORD;
use os-mmio-map::INP_BLOCK_OFF;

// ============================================================================
// Регистры (смещения в словах от начала блока INP)
// ============================================================================

/// Индекс записи устройства (RO для гостя): куда ляжет следующее событие
pub const R_HEAD : usize = 0;
/// Индекс чтения гостя (RW): гость двигает после обработки
pub const R_TAIL : usize = 1;
/// Ёмкость кольца в событиях (RO)
pub const R_CAPACITY : usize = 2;
/// Начало кольца событий: 24 события по 2 слова
pub const R_RING : usize = 3;

/// Ёмкость кольца (событий)
pub const RING_CAPACITY : usize = 24;

// ============================================================================
// Формат события: 2 слова
//   w0 = type(u8) | code(u8)<<8 | reserved(u16)<<16
//   w1 = x(i16) | y(i16)<<16      — виртуальные координаты DISP (1458×729)
// ============================================================================

/// Типы событий
pub const EV_KEY_DOWN : usize = 1;
pub const EV_KEY_UP : usize = 2;
pub const EV_PTR_MOVE : usize = 3;
pub const EV_PTR_DOWN : usize = 4;
pub const EV_PTR_UP : usize = 5;

pub const InputEvent = struct {
    ev_type : u8,
    code : u8,
    x : i16,
    y : i16,
};

// ============================================================================
// Семантика
// ============================================================================

/// Носитель кладёт событие в кольцо
fn inp_push(ev: InputEvent) -> bool {
    // Implementation: если (HEAD+1)%CAP == TAIL%CAP — кольцо полно,
    // событие отбрасывается, вернуть false; иначе записать 2 слова
    // по адресу R_RING + (HEAD%CAP)*2 и инкрементировать HEAD.
}

/// Гость забирает события: пока TAIL != HEAD — читать 2 слова, двигать TAIL
fn inp_drain() -> [InputEvent] {
    // Implementation: чтение неразрушающее; только запись TAIL освобождает слот.
}

// ============================================================================
// Инварианты и голдены
// ============================================================================
//
// INVARIANT I1: HEAD и TAIL монотонно растут (mod 2^32); (HEAD-TAIL) <= CAP.
// INVARIANT I2: устройство никогда не пишет в слот, который гость не освободил.
// INVARIANT I3: гость пишет только R_TAIL; запись других регистров — no-op.
//
// GOLDEN G-INP-1: push(KEY_DOWN,'q',0,0); push(PTR_DOWN,1,729,364) →
//   HEAD=2, TAIL=0; слова кольца:
//   [0] = 1 | 113<<8, [1] = 0, [2] = 4 | 1<<8, [3] = 729 | 364<<16.
// GOLDEN G-INP-2: при TAIL=0 кольцо вмещает CAP-1 = 23 события;
//   24-й push подряд отвергается (возврат false, HEAD не движется).
