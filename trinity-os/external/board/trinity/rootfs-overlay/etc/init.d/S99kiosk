#!/bin/sh
# Trinity OS L0: полноэкранный веб-киоск — cog (WPE WebKit) прямо на DRM/KMS,
# без X11 и Wayland-композитора. Перезапускается при падении.

KIOSK_CONF=/opt/trinity/etc/kiosk.conf
PIDFILE=/var/run/kiosk-loop.pid
LOG=/var/log/kiosk.log

start() {
    [ -r "$KIOSK_CONF" ] && . "$KIOSK_CONF"
    KIOSK_URL="${KIOSK_URL:-http://127.0.0.1:8080/}"

    export XDG_RUNTIME_DIR=/run/user/0
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 0700 "$XDG_RUNTIME_DIR"
    # Кэш WPE (тайлы, http-кэш) — переживает перезагрузку приложения
    export XDG_CACHE_HOME=/var/cache/kiosk
    mkdir -p "$XDG_CACHE_HOME"

    printf "Starting kiosk (%s): " "$KIOSK_URL"
    (
        while :; do
            cog -P drm "$KIOSK_URL" >> "$LOG" 2>&1
            echo "kiosk: cog exited ($?), restarting in 2s" >> "$LOG"
            sleep 2
        done
    ) &
    echo $! > "$PIDFILE"
    echo "OK"
}

stop() {
    printf "Stopping kiosk: "
    [ -r "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    killall cog 2>/dev/null
    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) stop; start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
