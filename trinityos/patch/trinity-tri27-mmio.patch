+// ═══════════════════════════════════════════════════════════════════════
+// TRINITYOS MMIO HOOKS (Ring 0.5)
+// LD/ST со словесным индексом в окне [17496, 19683) уходят устройствам
+// вместо памяти. Хуки ставит носитель (trios_runner); null — поведение
+// без изменений. Спека окна: trinityos/specs/os/mmio_map.t27.
+// ═══════════════════════════════════════════════════════════════════════
+// ADR-M1: immediate LD/ST — 15 бит со знаком (см. decode ниже), адресуемы
+// только слова 0..16383, поэтому окно сидит на 2*3^8, а не в верху памяти.
+pub const MMIO_BASE_WORD: usize = 13122; // 2 * 3^8
+pub const MMIO_END_WORD: usize = 15309; // 13122 + 3^7
+
+pub const MmioHooks = struct {
+    ctx: *anyopaque,
+    load: *const fn (ctx: *anyopaque, word_addr: u32) u32,
+    store: *const fn (ctx: *anyopaque, word_addr: u32, value: u32, ram: []u8) void,
+};
+
+pub var mmio_hooks: ?MmioHooks = null;
+
