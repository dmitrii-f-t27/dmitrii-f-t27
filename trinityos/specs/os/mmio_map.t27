// SPDX-License-Identifier: Apache-2.0
// trinityos/specs/os/mmio_map.t27 — TrinityOS Ring 0.5: карта MMIO-пространства
// Единственный источник истины для адресов всех устройств.
// φ² + 1/φ² = 3 | TRINITY

module os-mmio-map;

use tritype-base::usize;

// ============================================================================
// Адресный план
// ============================================================================
//
// Память TRI-27: 3^9 = 19683 слова по 32 бита (little-endian, словесная
// адресация LD/ST, как в trinity/src/tri27/emu/executor.zig).
//
// Окно MMIO — 3^7 = 2187 слов с базой 2*3^8 = 13122. Причина выбора базы
// (ADR-M1): immediate инструкций LD/ST кодируется 15 битами со знаком
// (decoder.zig, биты [31:17]) — адресуемы только слова 0..16383, поэтому
// «верх памяти» для окна недостижим, пока ISA не получит косвенную
// адресацию или широкий immediate. Тогда окно вернётся в топ (3^9 - 3^7).
//
// Каждое устройство получает блок 3^5 = 243 слова; хвост окна — кольцевой
// буфер дисплей-листа.
//
//   слова      0 .. 13121   ОЗУ гостя (код, данные, стек)
//   слова  13122 .. 15308   MMIO (это окно)
//   слова  15309 .. 19682   ОЗУ гостя (продолжение)
//
//   13122 +   0 .. 242      CLK   (os-dev-clk)
//   13122 + 243 .. 485      INP   (os-dev-inp)
//   13122 + 486 .. 728      NET   (os-dev-net)
//   13122 + 729 .. 971      DISP  регистры (os-dev-disp)
//   13122 + 972 .. 2186     DISP  кольцо дисплей-листа (1215 слов = 607 команд)

/// Размер памяти в словах: 3^9
pub const MEMORY_SIZE_WORDS : usize = 19683;

/// База MMIO-окна (в словах): 2 * 3^8 (см. ADR-M1 выше)
pub const MMIO_BASE_WORD : usize = 13122;

/// Конец MMIO-окна (в словах, не включительно): 13122 + 2187
pub const MMIO_END_WORD : usize = 15309;

/// База MMIO-окна (в байтах): MMIO_BASE_WORD * 4
pub const MMIO_BASE_BYTE : usize = 52488;

/// Размер блока одного устройства (в словах): 3^5
pub const DEV_BLOCK_WORDS : usize = 243;

/// Смещения блоков устройств от MMIO_BASE_WORD (в словах)
pub const CLK_BLOCK_OFF : usize = 0;
pub const INP_BLOCK_OFF : usize = 243;
pub const NET_BLOCK_OFF : usize = 486;
pub const DISP_REG_OFF : usize = 729;
pub const DISP_RING_OFF : usize = 972;

/// Длина кольца дисплей-листа (в словах): 5 * 3^5
pub const DISP_RING_WORDS : usize = 1215;

// ============================================================================
// Функции
// ============================================================================

/// Попадает ли словесный адрес в MMIO-окно
fn is_mmio_word(word_addr: u32) -> bool {
    // Implementation: word_addr >= MMIO_BASE_WORD && word_addr < MMIO_END_WORD
}

/// Попадает ли байтовый адрес в MMIO-окно
fn is_mmio_byte(byte_addr: u32) -> bool {
    // Implementation: byte_addr >= MMIO_BASE_BYTE && byte_addr < MMIO_END_WORD * 4
}

// ============================================================================
// Инварианты
// ============================================================================
//
// INVARIANT M1: блоки устройств не пересекаются и покрывают окно без дыр:
//              CLK ∪ INP ∪ NET ∪ DISP_REG ∪ DISP_RING = [13122, 15309).
// INVARIANT M2: 4*DEV_BLOCK_WORDS + DISP_RING_WORDS = 2187 = 3^7.
// INVARIANT M3: сегменты загружаемых образов не смеют пересекать окно;
//              загрузчик обязан отвергать такие образы.
// INVARIANT M4: доступ в MMIO только словами по выровненным адресам
//              (byte_addr % 4 == 0); невыровненный доступ — fault устройства.
// INVARIANT M5: окно целиком лежит в диапазоне 15-битного immediate LD/ST:
//              MMIO_END_WORD - 1 <= 16383 (пока действует ADR-M1).
//
// GOLDEN G-MAP-1: is_mmio_word(13121) = false; is_mmio_word(13122) = true;
//                 is_mmio_word(15308) = true; is_mmio_word(15309) = false.
// GOLDEN G-MAP-2: is_mmio_byte(52484) = false; is_mmio_byte(52488) = true.
