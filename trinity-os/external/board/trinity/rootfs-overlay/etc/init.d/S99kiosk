#!/bin/sh
# Trinity OS L0: полноэкранный веб-киоск — cog (WPE WebKit) прямо на DRM/KMS,
# без X11 и Wayland-композитора. Перезапускается при падении.

KIOSK_CONF=/opt/trinity/etc/kiosk.conf
PIDFILE=/var/run/kiosk-loop.pid
LOG=/var/log/kiosk.log

start() {
    [ -r "$KIOSK_CONF" ] && . "$KIOSK_CONF"
    KIOSK_URL="${KIOSK_URL:-http://127.0.0.1:8080/}"

    export XDG_RUNTIME_DIR=/run/user/0
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 0700 "$XDG_RUNTIME_DIR"
    # Кэш WPE (тайлы, http-кэш) — переживает перезагрузку приложения
    export XDG_CACHE_HOME=/var/cache/kiosk
    mkdir -p "$XDG_CACHE_HOME"

    # Выбор рендерера cog:
    #  - gles    — аппаратный (iris/radeonsi на железе, virgl в KVM);
    #  - modeset — программный SHM-путь (llvmpipe/kms_swrast), единственный
    #              рабочий вариант на virtio-gpu без virgl (QEMU без -gl).
    # Признак virgl — первый бит фич virtio-устройства (VIRTIO_GPU_F_VIRGL).
    RENDERER="$KIOSK_RENDERER"
    if [ -z "$RENDERER" ]; then
        # gles — только на драйверах с настоящим GL (Intel/AMD, virtio+virgl);
        # bochs/прочие и virtio без virgl — программный modeset
        drv=$(basename "$(readlink /sys/class/drm/card0/device/driver 2>/dev/null)" 2>/dev/null)
        case "$drv" in
            i915|amdgpu) RENDERER=gles ;;
            virtio*)
                RENDERER=modeset
                for f in /sys/class/drm/card0/device/virtio*/features; do
                    [ -r "$f" ] || continue
                    [ "$(head -c1 "$f")" = "1" ] && RENDERER=gles
                done
                ;;
            *) RENDERER=modeset ;;
        esac
    fi

    printf "Starting kiosk (%s, renderer=%s): " "$KIOSK_URL" "$RENDERER"
    touch "$LOG"
    (
        fails=0
        while :; do
            start=$(date +%s)
            logmark=$(wc -l < "$LOG" 2>/dev/null || echo 0)
            COG_PLATFORM_PARAMS="renderer=$RENDERER" cog -P drm "$KIOSK_URL" >> "$LOG" 2>&1 &
            COGPID=$!
            # Сторож: падающий по кругу WPEWebProcess не роняет cog — добиваем сами
            while kill -0 "$COGPID" 2>/dev/null; do
                sleep 5
                crashes=$(tail -n "+$((logmark + 1))" "$LOG" 2>/dev/null | grep -c "renderer process crashed")
                if [ "$crashes" -ge 3 ]; then
                    echo "kiosk: WPEWebProcess crash-loop, перезапускаю cog" >> "$LOG"
                    kill "$COGPID" 2>/dev/null
                    break
                fi
            done
            wait "$COGPID"
            rc=$?
            dur=$(( $(date +%s) - start ))
            echo "kiosk: cog ($RENDERER) exited ($rc) after ${dur}s, restarting in 2s" >> "$LOG"
            if [ "$RENDERER" = "gles" ] && [ "$dur" -lt 30 ]; then
                fails=$((fails + 1))
                if [ "$fails" -ge 2 ]; then
                    echo "kiosk: gles не взлетает — перехожу на софт-рендер (modeset)" >> "$LOG"
                    RENDERER=modeset
                fi
            fi
            sleep 2
        done
    ) &
    echo $! > "$PIDFILE"
    echo "OK"
}

stop() {
    printf "Stopping kiosk: "
    [ -r "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    killall cog 2>/dev/null
    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) stop; start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
